---
/**
 * Renders a single project as a block in the vertical listing.
 * No card chrome - just typography, a type badge, and either a deferred
 * StatsIsland for live data (hosted/oss) or an inline WipContent (wip).
 *
 * Hosted and wip projects get a larger, more prominent treatment because
 * they have richer content (description, features, tech, CTA button).
 * OSS projects are compact rows - name + description + one stats line + link.
 */
import type { Project } from "../config/projects";
import StatsIsland from "./StatsIsland.astro";
import StatsSkeleton from "./StatsSkeleton.astro";
import WipContent from "./WipContent.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;

type Role = "hosted" | "wip" | "library" | "plugin" | "mod";
const role: Role =
  project.type === "hosted" ? "hosted"
  : project.type === "wip" ? "wip"
  : project.role;

const badge =
  role === "hosted" ? "HOSTED SERVICE"
  : role === "wip" ? "IN DEVELOPMENT"
  : role === "library" ? "LIBRARY"
  : role === "plugin" ? "PLUGIN"
  : "MOD";

const badgeIcon =
  role === "hosted" ? "●"
  : role === "wip" ? "◐"
  : role === "library" ? "◆"
  : role === "plugin" ? "◇"
  : "⬢";

// Hosted is brightest (live), wip uses the same accent green to signal
// "actively being built", oss falls back to muted.
const badgeColor =
  role === "hosted" || role === "wip"
    ? "text-[var(--color-accent)]"
    : "text-[var(--color-muted)]";

const isLargeTile = project.type === "hosted" || project.type === "wip";
---

{isLargeTile ? (
  <article class="flex flex-col gap-5">
    <div class={`flex items-center gap-2 text-xs font-medium uppercase tracking-[0.14em] ${badgeColor}`}>
      <span aria-hidden="true">{badgeIcon}</span>
      <span>{badge}</span>
    </div>

    <h3 class="text-5xl font-semibold leading-none tracking-tight text-[var(--color-text)] md:text-6xl">
      {project.name}
    </h3>

    {project.type === "hosted" ? (
      <StatsIsland project={project} server:defer>
        <StatsSkeleton variant="hosted" slot="fallback" />
      </StatsIsland>
    ) : project.type === "wip" ? (
      <WipContent project={project} />
    ) : null}
  </article>
) : (
  <article class="flex flex-col gap-3 border-t border-[var(--color-border)] pt-6">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-2xl font-semibold tracking-tight text-[var(--color-text)]">
        <span aria-hidden="true" class={`mr-2 ${badgeColor}`}>{badgeIcon}</span>
        {project.name}
      </h3>
      <span class={`text-xs font-medium uppercase tracking-[0.14em] ${badgeColor}`}>
        {badge}
      </span>
    </div>

    <StatsIsland project={project} server:defer>
      <StatsSkeleton variant="oss" slot="fallback" />
    </StatsIsland>
  </article>
)}
