---
import { execSync } from "node:child_process";
import "../styles/global.css";
import Project from "../components/Project.astro";
import AgeCounter from "../components/AgeCounter.astro";
import DiscordPresence from "../components/DiscordPresence.astro";
import RandomQuote from "../components/RandomQuote.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import { projects, type Project as ProjectType } from "../config/projects";

export const prerender = true;

const hosted: ProjectType[] = projects.filter((p) => p.type === "hosted");
const oss: ProjectType[] = projects.filter((p) => p.type === "oss");

const year = new Date().getFullYear();

/**
 * Resolve the commit SHA the site was built from so we can stamp it into the
 * footer. Vercel injects `VERCEL_GIT_COMMIT_SHA` on every deploy; for local
 * builds we shell out to git. Anywhere both fail (e.g. a sandboxed CI without
 * git), we hide the badge instead of breaking the build.
 */
function resolveBuildCommit(): string | null {
  const fromEnv = process.env.VERCEL_GIT_COMMIT_SHA;
  if (fromEnv) return fromEnv;
  try {
    return execSync("git rev-parse HEAD", { encoding: "utf-8" }).trim();
  } catch {
    return null;
  }
}

const buildCommit = resolveBuildCommit();
const buildCommitShort = buildCommit?.slice(0, 7) ?? null;
const buildCommitUrl = buildCommit
  ? `https://github.com/dnocturne/dnoct.me/commit/${buildCommit}`
  : null;

// --- SEO & social metadata ----------------------------------------------------
// Centralized so <title>, <meta name="description">, OpenGraph, Twitter Card,
// and JSON-LD all stay in sync. Keep `seoDescription` ≤ ~160 chars so SERPs
// don't truncate it.
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dnoct.me";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://dnoct.me/").toString();
const seoTitle = "dnoct.me — Dominykas Jankantas";
const seoDescription =
  "Dominykas Jankantas (dnocturne) — a CS student in Lithuania. Projects: nyx (Discord bot), basalt (Minecraft library), afflictions (Minecraft plugin).";

// Person + WebSite structured data via @graph so Google can link the two.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: "Dominykas Jankantas",
      alternateName: "dnocturne",
      url: `${siteUrl}/`,
      jobTitle: "Software developer",
      affiliation: {
        "@type": "CollegeOrUniversity",
        name: "Klaipėdos valstybinė kolegija",
      },
      homeLocation: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressCountry: "LT",
          addressLocality: "Klaipėda",
        },
      },
      sameAs: [
        "https://github.com/dnocturne",
        "https://www.linkedin.com/in/dominykas-jankantas-315226361/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "dnoct.me",
      description: seoDescription,
      inLanguage: "en",
      author: { "@id": `${siteUrl}/#person` },
      publisher: { "@id": `${siteUrl}/#person` },
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Dominykas Jankantas" />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="dnoct.me" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Dominykas" />
    <meta property="profile:last_name" content="Jankantas" />
    <meta property="profile:username" content="dnocturne" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />

    <!-- Discovery -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="me" href="https://github.com/dnocturne" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] antialiased">
    <div class="min-h-screen md:grid md:grid-cols-[20rem_1fr]">
      <aside
        class="flex flex-col gap-8 border-b border-[var(--color-border)] px-6 py-12 md:sticky md:top-0 md:h-screen md:border-b-0 md:border-r md:px-10 md:py-16"
      >
        <header class="flex flex-col gap-2">
          <h1 class="text-2xl font-medium tracking-tight">dnoct.me</h1>
          <div class="min-h-[3.75rem]">
            <RandomQuote server:defer>
              <div
                slot="fallback"
                class="flex flex-col gap-1.5"
                aria-hidden="true"
              >
                <div class="h-3 w-full animate-pulse rounded bg-[var(--color-border)]"></div>
                <div class="h-3 w-2/3 animate-pulse rounded bg-[var(--color-border)]"></div>
              </div>
            </RandomQuote>
          </div>
        </header>

        <p class="text-sm leading-relaxed text-[var(--color-muted)]">
          Third-year <span class="text-[var(--color-text)]">Informatika</span>
          (Computer Science) student at
          <span lang="lt" class="text-[var(--color-text)]">Klaipėdos valstybinė kolegija</span>.
        </p>

        <div class="flex flex-col gap-2">
          <AgeCounter
            year={2003}
            month={4}
            day={28}
            timezone="Europe/Vilnius"
            server:defer
          >
            <span
              slot="fallback"
              class="inline-block h-5 w-28 animate-pulse rounded bg-[var(--color-border)]"
              aria-hidden="true"
            ></span>
          </AgeCounter>

          <DiscordPresence
            userId="263304948291207170"
            username="dnocturne"
            steamId="76561197961705602"
            server:defer
          >
            <span
              slot="fallback"
              class="inline-block h-5 w-44 animate-pulse rounded bg-[var(--color-border)]"
              aria-hidden="true"
            ></span>
          </DiscordPresence>
        </div>

        <nav class="flex flex-col gap-1 text-sm">
          <a
            href="#running"
            class="text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
          >
            Running
          </a>
          <a
            href="#open-source"
            class="text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
          >
            Open source
          </a>
        </nav>

        <footer class="mt-auto flex flex-col gap-2 text-xs text-[var(--color-muted)]">
          <div class="flex flex-wrap gap-x-3 gap-y-1">
            <a
              href="https://github.com/dnocturne"
              class="transition-colors hover:text-[var(--color-text)]"
            >
              github
            </a>
            <span aria-hidden="true" class="text-[var(--color-dim)]">·</span>
            <a
              href="https://www.linkedin.com/in/dominykas-jankantas-315226361/"
              class="transition-colors hover:text-[var(--color-text)]"
            >
              linkedin
            </a>
            <span aria-hidden="true" class="text-[var(--color-dim)]">·</span>
            <a
              href="mailto:dominykas@dnoct.me"
              class="transition-colors hover:text-[var(--color-text)]"
            >
              email
            </a>
          </div>
          <span class="text-[var(--color-dim)]">&copy; {year}</span>
        </footer>
      </aside>

      <main class="flex flex-col gap-16 px-6 py-12 md:px-16 md:py-16 lg:px-20">
        {hosted.length > 0 && (
          <section id="running" class="flex flex-col gap-8 scroll-mt-12">
            <h2 class="text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-muted)]">
              Running
            </h2>
            {hosted.map((p) => <Project project={p} />)}
          </section>
        )}

        {oss.length > 0 && (
          <section id="open-source" class="flex flex-col gap-6 scroll-mt-12">
            <h2 class="text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-muted)]">
              Open source
            </h2>
            <div class="grid items-start gap-x-12 gap-y-6 sm:grid-cols-2">
              {oss.map((p) => <Project project={p} />)}
            </div>
          </section>
        )}

        <footer
          class="mt-auto flex flex-col gap-2 border-t border-[var(--color-border)] pt-8 text-xs text-[var(--color-muted)]"
        >
          <p>
            Built with <a href="https://astro.build" class="transition-colors hover:text-[var(--color-text)]">Astro</a> and <a href="https://tailwindcss.com" class="transition-colors hover:text-[var(--color-text)]">Tailwind CSS</a>, hosted on <a href="https://vercel.com" class="transition-colors hover:text-[var(--color-text)]">Vercel</a>. Type set in <span class="text-[var(--color-text)]">Inter</span> and <span class="font-mono text-[var(--color-text)]">JetBrains Mono</span>.
          </p>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <a
              href="https://github.com/dnocturne/dnoct.me"
              class="inline-flex items-center gap-1 transition-colors hover:text-[var(--color-text)]"
            >
              <span>view source of this site</span>
              <span aria-hidden="true">↗</span>
            </a>
            {buildCommitShort && buildCommitUrl && (
              <>
                <span class="text-[var(--color-dim)]">·</span>
                <span>built from</span>
                <a
                  href={buildCommitUrl}
                  class="tabular font-mono transition-colors hover:text-[var(--color-text)]"
                  title={buildCommit ?? undefined}
                >
                  {buildCommitShort}
                </a>
              </>
            )}
          </div>
        </footer>
      </main>
    </div>

    <SpeedInsights />
    <Analytics />
  </body>
</html>
