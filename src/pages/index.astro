---
import { execSync } from "node:child_process";
import "../styles/global.css";
import Project from "../components/Project.astro";
import AgeCounter from "../components/AgeCounter.astro";
import DiscordPresence from "../components/DiscordPresence.astro";
import RandomQuote from "../components/RandomQuote.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import { projects, type Project as ProjectType } from "../config/projects";

export const prerender = true;

const hosted: ProjectType[] = projects.filter((p) => p.type === "hosted");
const wip: ProjectType[] = projects.filter((p) => p.type === "wip");
const oss: ProjectType[] = projects.filter((p) => p.type === "oss");

const navItems = [
  { href: "#running", n: "01", label: "Running" },
  { href: "#working-on", n: "02", label: "Working on" },
  { href: "#open-source", n: "03", label: "Open source" },
];

const year = new Date().getFullYear();

/**
 * Resolve the commit SHA the site was built from so we can stamp it into the
 * footer. Vercel injects `VERCEL_GIT_COMMIT_SHA` on every deploy; for local
 * builds we shell out to git. Anywhere both fail (e.g. a sandboxed CI without
 * git), we hide the badge instead of breaking the build.
 */
function resolveBuildCommit(): string | null {
  const fromEnv = process.env.VERCEL_GIT_COMMIT_SHA;
  if (fromEnv) return fromEnv;
  try {
    return execSync("git rev-parse HEAD", { encoding: "utf-8" }).trim();
  } catch {
    return null;
  }
}

const buildCommit = resolveBuildCommit();
const buildCommitShort = buildCommit?.slice(0, 7) ?? null;
const buildCommitUrl = buildCommit
  ? `https://github.com/dnocturne/dnoct.me/commit/${buildCommit}`
  : null;

// --- SEO & social metadata ----------------------------------------------------
// Centralized so <title>, <meta name="description">, OpenGraph, Twitter Card,
// and JSON-LD all stay in sync. Keep `seoDescription` ≤ ~160 chars so SERPs
// don't truncate it.
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dnoct.me";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://dnoct.me/").toString();
const seoTitle = "dnoct.me · Dominykas Jankantas";
const seoDescription =
  "Dominykas Jankantas (dnocturne), a software developer in Lithuania. Building nyx (Discord bot), vgrp.lt (GTA V multiplayer), plus Minecraft plugins and Steam Workshop mods.";

// Person + WebSite structured data via @graph so Google can link the two.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: "Dominykas Jankantas",
      alternateName: "dnocturne",
      url: `${siteUrl}/`,
      jobTitle: "Software developer",
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Klaipėdos valstybinė kolegija",
      },
      hasCredential: {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "degree",
        name: "Professional Bachelor of Computing in Informatics",
      },
      homeLocation: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressCountry: "LT",
          addressLocality: "Klaipėda",
        },
      },
      sameAs: [
        "https://github.com/dnocturne",
        "https://www.linkedin.com/in/dominykas-jankantas-315226361/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "dnoct.me",
      description: seoDescription,
      inLanguage: "en",
      author: { "@id": `${siteUrl}/#person` },
      publisher: { "@id": `${siteUrl}/#person` },
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Dominykas Jankantas" />
    <meta name="theme-color" content="#121318" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="dnoct.me" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Dominykas" />
    <meta property="profile:last_name" content="Jankantas" />
    <meta property="profile:username" content="dnocturne" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />

    <!-- Discovery -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="me" href="https://github.com/dnocturne" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body id="top" class="relative min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <div class="atmosphere" aria-hidden="true"></div>

    <!-- Slim sticky top bar: brand left, section index center, Discord right. -->
    <header
      class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_72%,transparent)] backdrop-blur-md"
    >
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6 md:px-10">
        <a href="#top" class="group flex items-center gap-2">
          <span class="font-display text-lg font-medium text-[var(--color-text)]">dnoct.me</span>
          <span
            class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-2)] shadow-[0_0_8px_var(--color-accent-2)]"
            aria-hidden="true"
          ></span>
        </a>

        <nav class="hidden items-center gap-7 text-sm sm:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="group flex items-baseline gap-2 text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
            >
              <span class="font-display text-xs text-[var(--color-dim)] transition-colors group-hover:text-[var(--color-accent-2)]">
                {item.n}
              </span>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>

        <a
          href="https://discord.dnoct.me"
          class="group inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-3 py-1.5 text-sm text-[var(--color-muted)] transition-colors hover:border-[var(--color-accent-2-dim)] hover:text-[var(--color-text)]"
        >
          <img src="/discord.svg" class="h-4 w-auto shrink-0" alt="" aria-hidden="true" />
          <span class="hidden sm:inline">Discord</span>
        </a>
      </div>
    </header>

    <div class="relative z-[1] mx-auto max-w-6xl px-6 md:px-10">
      <!-- HERO -->
      <section class="relative flex flex-col justify-center pt-14 pb-16">
        <p class="reveal text-[0.7rem] font-medium uppercase tracking-[0.42em] text-[var(--color-accent-2)]">
          @dnocturne · software developer
        </p>

        <h1
          class="reveal mt-6 font-display text-[clamp(3rem,12vw,9.5rem)] font-medium leading-[0.82] text-[var(--color-text)]"
          style="animation-delay:60ms"
        >
          Dominykas<br />Jankantas
        </h1>

        <div class="reveal mt-8 flex max-w-xl flex-col gap-5" style="animation-delay:200ms">
          <p class="text-sm leading-relaxed text-[var(--color-muted)]">
            <span class="text-[var(--color-text)]">Professional Bachelor of Computing in Informatics</span>, graduated 2026 from
            <span lang="lt" class="text-[var(--color-text)]">Klaipėdos valstybinė kolegija</span>. Based in Klaipėda, Lithuania.
          </p>

          <div class="min-h-[1.5rem]">
            <RandomQuote server:defer>
              <div slot="fallback" class="h-4 w-2/3 animate-pulse rounded bg-[var(--color-border)]" aria-hidden="true"></div>
            </RandomQuote>
          </div>

          <div class="flex flex-col gap-2 border-l-2 border-[var(--color-accent-dim)] pl-5 text-sm">
            <AgeCounter
              year={2003}
              month={4}
              day={28}
              timezone="Europe/Vilnius"
              server:defer
            >
              <span
                slot="fallback"
                class="inline-block h-5 w-28 animate-pulse rounded bg-[var(--color-border)]"
                aria-hidden="true"
              ></span>
            </AgeCounter>

            <DiscordPresence
              userId="263304948291207170"
              username="dnocturne"
              steamId="76561197961705602"
              server:defer
            >
              <span
                slot="fallback"
                class="inline-block h-5 w-44 animate-pulse rounded bg-[var(--color-border)]"
                aria-hidden="true"
              ></span>
            </DiscordPresence>
          </div>
        </div>

        <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="animation-delay:280ms">
          <a
            href="https://discord.dnoct.me"
            class="group inline-flex items-center gap-3 rounded-xl border border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-discord)_55%,transparent)] px-4 py-3 backdrop-blur-sm transition-colors hover:border-[var(--color-accent-2-dim)]"
          >
            <img src="/discord.svg" class="h-6 w-auto shrink-0" alt="" aria-hidden="true" />
            <span class="flex flex-col leading-tight text-left">
              <span class="text-sm font-medium text-[var(--color-text)]">Join my Discord</span>
              <span class="text-xs text-[var(--color-muted)]">discord.dnoct.me</span>
            </span>
            <span class="ml-1 text-[var(--color-dim)] transition-colors group-hover:text-[var(--color-accent-2)]" aria-hidden="true">↗</span>
          </a>

          <div class="flex items-center gap-x-4 px-2 text-sm text-[var(--color-muted)]">
            <a href="https://github.com/dnocturne" class="transition-colors hover:text-[var(--color-text)]">github</a>
            <span aria-hidden="true" class="text-[var(--color-dim)]">·</span>
            <a href="https://www.linkedin.com/in/dominykas-jankantas-315226361/" class="transition-colors hover:text-[var(--color-text)]">linkedin</a>
            <span aria-hidden="true" class="text-[var(--color-dim)]">·</span>
            <a href="mailto:dominykas@dnoct.me" class="transition-colors hover:text-[var(--color-text)]">email</a>
          </div>
        </div>
      </section>

      <main class="flex flex-col gap-24 pb-16">
        {hosted.length > 0 && (
          <section id="running" class="flex flex-col gap-10 scroll-mt-24">
            <div class="flex items-center gap-4">
              <span class="font-display text-base text-[var(--color-accent-2)]">01</span>
              <h2 class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-muted)]">Running</h2>
              <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-border)] to-transparent"></span>
            </div>
            {hosted.map((p) => <Project project={p} />)}
          </section>
        )}

        {wip.length > 0 && (
          <section id="working-on" class="flex flex-col gap-10 scroll-mt-24">
            <div class="flex items-center gap-4">
              <span class="font-display text-base text-[var(--color-accent-2)]">02</span>
              <h2 class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-muted)]">Working on</h2>
              <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-border)] to-transparent"></span>
            </div>
            {wip.map((p) => <Project project={p} />)}
          </section>
        )}

        {oss.length > 0 && (
          <section id="open-source" class="flex flex-col gap-8 scroll-mt-24">
            <div class="flex items-center gap-4">
              <span class="font-display text-base text-[var(--color-accent-2)]">03</span>
              <h2 class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-muted)]">Open source</h2>
              <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-border)] to-transparent"></span>
            </div>
            <div class="grid items-start gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
              {oss.map((p) => <Project project={p} />)}
            </div>
          </section>
        )}
      </main>

      <footer class="flex flex-col gap-2 border-t border-[var(--color-border)] py-8 text-xs text-[var(--color-muted)]">
        <p>
          Built with <a href="https://astro.build" class="transition-colors hover:text-[var(--color-text)]">Astro</a> and <a href="https://tailwindcss.com" class="transition-colors hover:text-[var(--color-text)]">Tailwind CSS</a>, hosted on <a href="https://vercel.com" class="transition-colors hover:text-[var(--color-text)]">Vercel</a>. Set in <span class="font-display text-[var(--color-text)]">Fraunces</span> &amp; <span class="text-[var(--color-text)]">Geist</span>. Logos via <a href="https://svgl.app" class="transition-colors hover:text-[var(--color-text)]">svgl.app</a>.
        </p>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <a
            href="https://github.com/dnocturne/dnoct.me"
            class="inline-flex items-center gap-1 transition-colors hover:text-[var(--color-text)]"
          >
            <span>view source of this site</span>
            <span aria-hidden="true">↗</span>
          </a>
          {buildCommitShort && buildCommitUrl && (
            <>
              <span class="text-[var(--color-dim)]">·</span>
              <span>built from</span>
              <a
                href={buildCommitUrl}
                class="tabular transition-colors hover:text-[var(--color-text)]"
                title={buildCommit ?? undefined}
              >
                {buildCommitShort}
              </a>
            </>
          )}
          <span class="text-[var(--color-dim)]">·</span>
          <span class="text-[var(--color-dim)]">&copy; {year} Dominykas Jankantas</span>
        </div>
      </footer>
    </div>

    <SpeedInsights />
    <Analytics />
  </body>
</html>
